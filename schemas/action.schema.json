{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kiseki.local/schemas/action.schema.json",
  "title": "KISEKI Action",
  "description": "KISEKI 统一动作协议：高层动作（L2/L3）与 200 ms 底层动作块（L1）。所有动作可带 source/timestamp/expect，便于回放与归因。",
  "oneOf": [
    { "$ref": "#/$defs/key" },
    { "$ref": "#/$defs/click" },
    { "$ref": "#/$defs/move" },
    { "$ref": "#/$defs/wait" },
    { "$ref": "#/$defs/skill" },
    { "$ref": "#/$defs/chunk" },
    { "$ref": "#/$defs/plan" },
    { "$ref": "#/$defs/noop" }
  ],
  "$defs": {
    "source": {
      "type": "string",
      "enum": ["planner", "skill", "reflex", "human", "replay"],
      "description": "动作来源，用于归因与数据筛选"
    },
    "expect": {
      "type": "object",
      "description": "后置条件；执行后必须验证，否则视为失败",
      "properties": {
        "screen": { "type": "string" },
        "anchor": { "type": "string" },
        "state": { "type": "object" },
        "within_ms": { "type": "number", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "meta": {
      "type": "object",
      "description": "自由附加信息（技能名、任务 id、模型名等）",
      "additionalProperties": true
    },

    "key": {
      "type": "object",
      "description": "按键：tap/hold/release；keys 可多键同时按",
      "required": ["type", "keys"],
      "properties": {
        "type": { "const": "key" },
        "keys": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1,
          "maxItems": 12
        },
        "action": { "type": "string", "enum": ["tap", "hold", "release"], "default": "tap" },
        "hold_ms": { "type": "number", "minimum": 0, "maximum": 10000, "default": 40 },
        "timestamp": { "type": "number" },
        "source": { "$ref": "#/$defs/source" },
        "expect": { "$ref": "#/$defs/expect" },
        "meta": { "$ref": "#/$defs/meta" }
      },
      "additionalProperties": false
    },

    "click": {
      "type": "object",
      "description": "点击：优先用 UI 锚点（分辨率无关），其次绝对坐标",
      "required": ["type", "target"],
      "properties": {
        "type": { "const": "click" },
        "target": {
          "oneOf": [
            {
              "type": "object",
              "required": ["anchor"],
              "properties": { "anchor": { "type": "string" } },
              "additionalProperties": false
            },
            {
              "type": "object",
              "required": ["x", "y"],
              "properties": {
                "x": { "type": "number", "minimum": 0, "maximum": 1 },
                "y": { "type": "number", "minimum": 0, "maximum": 1 }
              },
              "additionalProperties": false
            }
          ],
          "description": "anchor 为模板 id；x/y 为归一化屏幕坐标（0..1）"
        },
        "button": { "type": "string", "enum": ["left", "right", "middle"], "default": "left" },
        "clicks": { "type": "integer", "minimum": 1, "maximum": 3, "default": 1 },
        "hold_ms": { "type": "number", "minimum": 0, "maximum": 5000, "default": 60 },
        "timestamp": { "type": "number" },
        "source": { "$ref": "#/$defs/source" },
        "expect": { "$ref": "#/$defs/expect" },
        "meta": { "$ref": "#/$defs/meta" }
      },
      "additionalProperties": false
    },

    "move": {
      "type": "object",
      "description": "鼠标相对移动；dx/dy 为像素，relative=true 时相对当前位置",
      "required": ["type", "dx", "dy"],
      "properties": {
        "type": { "const": "move" },
        "dx": { "type": "number", "minimum": -10000, "maximum": 10000 },
        "dy": { "type": "number", "minimum": -10000, "maximum": 10000 },
        "relative": { "type": "boolean", "default": true },
        "duration_ms": { "type": "number", "minimum": 0, "maximum": 2000, "default": 0 },
        "timestamp": { "type": "number" },
        "source": { "$ref": "#/$defs/source" },
        "expect": { "$ref": "#/$defs/expect" },
        "meta": { "$ref": "#/$defs/meta" }
      },
      "additionalProperties": false
    },

    "wait": {
      "type": "object",
      "description": "等待条件成立；超时则失败，由上层重试或降级",
      "required": ["type", "condition"],
      "properties": {
        "type": { "const": "wait" },
        "condition": {
          "type": "object",
          "required": ["kind"],
          "properties": {
            "kind": {
              "type": "string",
              "enum": ["screen", "anchor", "stable", "seconds", "state"]
            },
            "screen": { "type": "string" },
            "anchor": { "type": "string" },
            "stable_ms": { "type": "number", "minimum": 0 },
            "seconds": { "type": "number", "minimum": 0 },
            "state": { "type": "object" }
          },
          "additionalProperties": false
        },
        "timeout_ms": { "type": "number", "minimum": 0, "maximum": 600000, "default": 30000 },
        "timestamp": { "type": "number" },
        "source": { "$ref": "#/$defs/source" },
        "expect": { "$ref": "#/$defs/expect" },
        "meta": { "$ref": "#/$defs/meta" }
      },
      "additionalProperties": false
    },

    "skill": {
      "type": "object",
      "description": "调用 L2 技能；参数由 L3 填充，技能内部保证后置条件",
      "required": ["type", "name"],
      "properties": {
        "type": { "const": "skill" },
        "name": { "type": "string" },
        "args": { "type": "object", "additionalProperties": true },
        "timeout_ms": { "type": "number", "minimum": 0, "maximum": 1800000, "default": 60000 },
        "retries": { "type": "integer", "minimum": 0, "maximum": 10, "default": 0 },
        "timestamp": { "type": "number" },
        "source": { "$ref": "#/$defs/source" },
        "expect": { "$ref": "#/$defs/expect" },
        "meta": { "$ref": "#/$defs/meta" }
      },
      "additionalProperties": false
    },

    "chunk": {
      "type": "object",
      "description": "GameScaling 200 ms 动作块：x/y 为千分位鼠标位移（±1000），z 为滚轮（±5），groups 为 6×33.33 ms 的按键组，每组最多 4 键",
      "required": ["type", "x", "y", "z", "groups"],
      "properties": {
        "type": { "const": "chunk" },
        "x": { "type": "number", "minimum": -1000, "maximum": 1000 },
        "y": { "type": "number", "minimum": -1000, "maximum": 1000 },
        "z": { "type": "number", "minimum": -5, "maximum": 5 },
        "groups": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "items": {
            "type": "array",
            "maxItems": 4,
            "items": { "type": "string" }
          },
          "description": "6 个子步；空数组表示该子步不按键"
        },
        "raw": { "type": "string", "description": "模型原始文本，便于回放与调试" },
        "timestamp": { "type": "number" },
        "source": { "$ref": "#/$defs/source" },
        "expect": { "$ref": "#/$defs/expect" },
        "meta": { "$ref": "#/$defs/meta" }
      },
      "additionalProperties": false
    },

    "plan": {
      "type": "object",
      "description": "L3 计划：目标 + 有序动作；执行器逐步校验，失败触发重规划",
      "required": ["type", "goal", "steps"],
      "properties": {
        "type": { "const": "plan" },
        "goal": { "type": "string" },
        "steps": {
          "type": "array",
          "items": { "$ref": "#" },
          "minItems": 1,
          "maxItems": 200
        },
        "max_steps": { "type": "integer", "minimum": 1, "maximum": 200, "default": 50 },
        "timestamp": { "type": "number" },
        "source": { "$ref": "#/$defs/source" },
        "expect": { "$ref": "#/$defs/expect" },
        "meta": { "$ref": "#/$defs/meta" }
      },
      "additionalProperties": false
    },

    "noop": {
      "type": "object",
      "description": "不动作；用于模型输出 no-op 或安全暂停",
      "required": ["type"],
      "properties": {
        "type": { "const": "noop" },
        "reason": { "type": "string" },
        "timestamp": { "type": "number" },
        "source": { "$ref": "#/$defs/source" },
        "expect": { "$ref": "#/$defs/expect" },
        "meta": { "$ref": "#/$defs/meta" }
      },
      "additionalProperties": false
    }
  }
}
